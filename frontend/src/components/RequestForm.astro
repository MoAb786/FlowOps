---
export interface Props {
  senderId?: string;
}

const { senderId = 'user_123' } = Astro.props;
---

<div class="bg-canvas rounded-[12px] p-[24px] sm:p-[40px] shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_1px_1px_rgba(0,0,0,0.05),0_8px_16px_-4px_rgba(0,0,0,0.1)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.14)] relative overflow-hidden font-sans">
  
  <div class="flex gap-[16px] items-start mb-[24px]">
    <div class="w-[48px] h-[48px] shrink-0 rounded-[8px] bg-canvas-soft border border-hairline flex items-center justify-center text-ink">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
    </div>
    <div>
      <h2 class="text-[24px] font-semibold text-ink tracking-[-0.96px] leading-[32px]">Submit a New Request</h2>
      <p class="text-[16px] text-body font-normal leading-[24px]">Tell us what you need and we'll get it moving.</p>
    </div>
  </div>

  <hr class="border-hairline mb-[32px]" />

  <form id="requestForm" class="flex flex-col gap-[24px]" data-sender-id={senderId}>
    <div>
      <label for="domain" class="block text-[14px] font-medium text-ink mb-[4px]">Select Domain</label>
      <p class="text-[14px] text-body mb-[12px] tracking-[-0.28px]">Choose the area that best matches your request.</p>
      <div class="relative">
        <select id="domain" name="domain" class="w-full h-[40px] px-[12px] bg-canvas border border-hairline rounded-[6px] text-ink text-[14px] focus:outline-none focus:border-[#0070f3] transition-colors appearance-none cursor-pointer">
          <option value="lab">Lab Equipment</option>
          <option value="restaurant">Restaurant</option>
        </select>
        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-mute">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>
    
    <div>
      <label for="request" class="block text-[14px] font-medium text-ink mb-[4px]">What do you need?</label>
      <p class="text-[14px] text-body mb-[12px] tracking-[-0.28px]">Describe your request in detail.</p>
      <textarea 
        id="request" 
        name="request" 
        rows="5" 
        placeholder="e.g. I need 2 Arduinos for my lab tomorrow" 
        class="w-full p-[12px] bg-canvas border border-hairline rounded-[6px] text-ink text-[14px] focus:outline-none focus:border-[#0070f3] transition-colors resize-none placeholder:text-mute"
      ></textarea>
    </div>

    <!-- Security / Info Card -->
    <div class="flex items-start gap-[12px] p-[16px] rounded-[8px] bg-canvas-soft border border-hairline mt-[8px]">
      <svg class="w-5 h-5 text-ink mt-[2px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
      <div>
        <h4 class="text-[14px] font-medium text-ink leading-[20px]">Secure. Transparent. Reliable.</h4>
        <p class="text-[14px] text-body mt-[4px] leading-[20px] tracking-[-0.28px]">All requests are tracked and secured with enterprise-grade protection.</p>
      </div>
    </div>
    
    <button 
      type="submit" 
      class="mt-[16px] h-[48px] w-full flex items-center justify-center gap-[8px] bg-primary text-on-primary rounded-full font-medium text-[16px] hover:opacity-90 transition-opacity"
    >
      Submit Request
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
    </button>
  </form>
  
  <div id="statusMessage" class="mt-[24px] hidden text-[14px] font-medium px-[16px] py-[12px] rounded-[8px] border"></div>
</div>

<script>
  const form = document.getElementById('requestForm');
  const statusMessage = document.getElementById('statusMessage');

  if (form && statusMessage) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = (document.getElementById('domain') as HTMLSelectElement).value;
      const requestText = (document.getElementById('request') as HTMLTextAreaElement).value;
      const senderId = form.getAttribute('data-sender-id') || 'user_123';
      
      statusMessage.className = "mt-[24px] text-[14px] font-medium px-[16px] py-[12px] rounded-[8px] border bg-canvas-soft border-hairline text-body block";
      statusMessage.textContent = "Submitting...";
      
      try {
        const response = await fetch('http://localhost:8000/requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: requestText, domain: domain, sender_id: senderId })
        });
        
        if (response.ok) {
          const result = await response.json();
          statusMessage.className = "mt-[24px] text-[14px] font-medium px-[16px] py-[12px] rounded-[8px] border bg-[#d3e5ff] dark:bg-[#0070f3]/20 border-[#0070f3]/30 text-[#0761d1] dark:text-[#3291ff] block";
          statusMessage.textContent = `Success! Request routed to ${result.record?.status || 'Unknown'} state.`;
          (form as HTMLFormElement).reset();
        } else {
          throw new Error("Server error");
        }
      } catch (err) {
        statusMessage.className = "mt-[24px] text-[14px] font-medium px-[16px] py-[12px] rounded-[8px] border bg-[#f7d4d6] dark:bg-[#ee0000]/20 border-[#ee0000]/30 text-[#c50000] dark:text-[#ff4d4d] block";
        statusMessage.textContent = "Error submitting request. Is the backend running?";
      }
    });
  }
</script>
