---
import Layout from '../layouts/Layout.astro';

// TODO: FUTURE API INTEGRATION
// The current data array is a mock dataset for development and rendering only.
// Notion (via the backend) will eventually act as the source of truth for request records.
// The frontend should replace this mock array with a fetch() call to the GET endpoint 
// once Person 1 adds it. Do NOT store this in localStorage.

let mockRequests = [];
try {
  const response = await fetch('http://127.0.0.1:8000/requests');
  if (response.ok) {
    mockRequests = await response.json();
  }
} catch (e) {
  console.error("Failed to fetch requests from backend:", e);
}

function getStatusBadgeClasses(status: string) {
  switch(status) {
    case 'Pending': return 'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-500/10 dark:text-amber-500 dark:border-amber-500/20';
    case 'Auto-Approved': return 'bg-emerald-100 text-emerald-800 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20';
    case 'Needs Clarification': return 'bg-orange-100 text-orange-800 border-orange-200 dark:bg-orange-500/10 dark:text-orange-400 dark:border-orange-500/20';
    case 'Executed': return 'bg-blue-100 text-blue-800 border-blue-200 dark:bg-blue-500/10 dark:text-blue-400 dark:border-blue-500/20';
    case 'Failed': return 'bg-red-100 text-red-800 border-red-200 dark:bg-red-500/10 dark:text-red-400 dark:border-red-500/20';
    default: return 'bg-slate-100 text-slate-800 border-slate-200 dark:bg-slate-500/10 dark:text-slate-400 dark:border-slate-500/20';
  }
}

function formatDate(isoString: string) {
  return new Date(isoString).toLocaleString('en-US', { 
    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
  });
}
---

<Layout title="Dashboard - FlowOps">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end mb-10 gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white mb-2">Dashboard</h1>
        <p class="text-slate-500 dark:text-slate-400 text-base">Track your recent requests and approvals.</p>
      </div>
      <a href="/" class="h-10 inline-flex items-center justify-center bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full px-6 font-medium text-sm hover:opacity-90 transition-opacity shrink-0 shadow-sm">
        + New Request
      </a>
    </div>

    {mockRequests.length === 0 ? (
      <div class="bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-3xl p-16 text-center shadow-sm">
        <div class="w-16 h-16 bg-slate-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm border border-slate-100 dark:border-slate-700">
          <svg class="w-8 h-8 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2 tracking-tight">No requests found</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm max-w-sm mx-auto leading-relaxed">You haven't submitted any requests yet. Start by creating a new request from the home page.</p>
      </div>
    ) : (
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-semibold text-[13px] uppercase tracking-wider">
              <tr>
                <th class="px-6 py-5 whitespace-nowrap">Request ID</th>
                <th class="px-6 py-5 whitespace-nowrap">Domain</th>
                <th class="px-6 py-5 min-w-[240px]">Event Details</th>
                <th class="px-6 py-5 whitespace-nowrap">Risk Level</th>
                <th class="px-6 py-5 whitespace-nowrap">Date</th>
                <th class="px-6 py-5 text-right whitespace-nowrap">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
              {mockRequests.map((req) => (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors group">
                  <td class="px-6 py-5 font-mono text-[13px] text-slate-400 dark:text-slate-500 whitespace-nowrap" title={req.request_id}>
                    {req.request_id.split('-')[0] + '...'}
                  </td>
                  <td class="px-6 py-5 capitalize font-semibold text-slate-900 dark:text-white whitespace-nowrap">
                    {req.domain === 'lab' ? 'Lab Equipment' : req.domain === 'restaurant' ? 'Restaurant' : req.domain}
                  </td>
                  <td class="px-6 py-5">
                    <div class="font-medium text-slate-900 dark:text-white capitalize mb-1">{req.event_type}</div>
                    <div class="text-slate-500 dark:text-slate-400 text-[13px] leading-relaxed">
                      {req.details?.items?.map((item: any) => `${item.quantity}x ${item.name}`).join(', ') || 'No items'}
                    </div>
                  </td>
                  <td class="px-6 py-5 whitespace-nowrap">
                    <span class="text-[11px] uppercase tracking-wider px-2.5 py-1 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md text-slate-600 dark:text-slate-300 font-bold">
                      {req.risk_level}
                    </span>
                  </td>
                  <td class="px-6 py-5 text-slate-500 dark:text-slate-400 whitespace-nowrap text-[13px] font-medium">
                    {formatDate(req.created_at)}
                  </td>
                  <td class="px-6 py-5 text-right whitespace-nowrap">
                    <span class={`inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold border uppercase tracking-wider shadow-sm ${getStatusBadgeClasses(req.status)}`}>
                      {req.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</Layout>
