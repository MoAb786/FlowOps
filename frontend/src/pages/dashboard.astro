---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My Requests — FlowOps">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-16 font-sans">
    
    <!-- HEADER SECTION -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end mb-6 gap-6">
      <div>
        <h1 class="text-[32px] font-semibold tracking-[-1.28px] text-[#171717] dark:text-[#ffffff] leading-[40px] mb-2">
          My Requests
        </h1>
        <p class="text-[16px] text-[#4d4d4d] dark:text-[#a1a1a1] font-normal leading-[24px]">
          Track the status of requests you have submitted.
        </p>
      </div>
      <!-- Link back to submission form; management/approval happens exclusively in Notion -->
      <a href="/" class="h-[48px] inline-flex items-center justify-center bg-[#171717] dark:bg-[#ffffff] text-[#ffffff] dark:text-[#171717] rounded-full px-[16px] font-medium text-[16px] leading-[24px] transition-colors hover:opacity-90 shrink-0">
        + Submit New Request
      </a>
    </div>

    <!-- READ-ONLY TRACKING NOTICE -->
    <!--
      IMPORTANT: This dashboard is a READ-ONLY requester tracking view.
      Requesters can see the current status of their submissions here.
      All approval, rejection, and management actions happen exclusively
      inside Notion — never through this interface.
    -->
    <div class="mb-8 flex items-start gap-3 bg-[#f0f7ff] dark:bg-[#0070f3]/10 border border-[#c2deff] dark:border-[#0070f3]/30 rounded-[8px] px-[16px] py-[12px]">
      <svg class="w-5 h-5 text-[#0070f3] dark:text-[#3291ff] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-[14px] text-[#0761d1] dark:text-[#3291ff] leading-[20px]">
        <span class="font-semibold">Tracking view only.</span>
        This page shows the live status of your submitted requests. All approvals and management actions are handled exclusively inside Notion by authorized operators.
      </p>
    </div>


    <!-- SUMMARY METRICS -->
    <div id="metrics-container" class="grid grid-cols-2 md:grid-cols-4 gap-[16px] mb-[32px] hidden">
      <div class="bg-[#ffffff] dark:bg-[#111] rounded-[8px] p-[24px] shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_1px_1px_rgba(0,0,0,0.05),0_2px_2px_rgba(0,0,0,0.05)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.14)]">
        <div class="text-[#4d4d4d] dark:text-[#888888] font-mono text-[12px] leading-[16px] mb-2 uppercase">Total Requests</div>
        <div class="text-[24px] font-semibold tracking-[-0.96px] text-[#171717] dark:text-[#ffffff] leading-[32px]" id="metric-total">-</div>
      </div>
      <div class="bg-[#ffffff] dark:bg-[#111] rounded-[8px] p-[24px] shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_1px_1px_rgba(0,0,0,0.05),0_2px_2px_rgba(0,0,0,0.05)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.14)]">
        <div class="text-[#4d4d4d] dark:text-[#888888] font-mono text-[12px] leading-[16px] mb-2 uppercase">Pending</div>
        <div class="text-[24px] font-semibold tracking-[-0.96px] text-[#f5a623] dark:text-[#f5a623] leading-[32px]" id="metric-pending">-</div>
      </div>
      <div class="bg-[#ffffff] dark:bg-[#111] rounded-[8px] p-[24px] shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_1px_1px_rgba(0,0,0,0.05),0_2px_2px_rgba(0,0,0,0.05)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.14)]">
        <div class="text-[#4d4d4d] dark:text-[#888888] font-mono text-[12px] leading-[16px] mb-2 uppercase">Auto-Approved</div>
        <div class="text-[24px] font-semibold tracking-[-0.96px] text-[#0070f3] dark:text-[#0070f3] leading-[32px]" id="metric-auto">-</div>
      </div>
      <div class="bg-[#ffffff] dark:bg-[#111] rounded-[8px] p-[24px] shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_1px_1px_rgba(0,0,0,0.05),0_2px_2px_rgba(0,0,0,0.05)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.14)]">
        <div class="text-[#4d4d4d] dark:text-[#888888] font-mono text-[12px] leading-[16px] mb-2 uppercase">Needs Attention</div>
        <div class="text-[24px] font-semibold tracking-[-0.96px] text-[#ee0000] dark:text-[#ee0000] leading-[32px]" id="metric-attention">-</div>
      </div>
    </div>

    <!-- FILTERS -->
    <div id="filters-container" class="mb-[24px] flex flex-col md:flex-row gap-[12px] hidden">
      <div class="flex-1 relative">
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-[#888888]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" id="filter-search" placeholder="Search requests..." class="w-full pl-9 pr-4 h-[40px] bg-[#ffffff] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333] rounded-[6px] text-[14px] text-[#171717] dark:text-[#ffffff] placeholder:text-[#888888] focus:outline-none focus:border-[#0070f3] transition-colors">
      </div>
      <select id="filter-domain" class="px-4 h-[40px] bg-[#ffffff] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333] rounded-[6px] text-[14px] text-[#171717] dark:text-[#ffffff] focus:outline-none focus:border-[#0070f3] transition-colors appearance-none min-w-[140px] cursor-pointer">
        <option value="all">All Domains</option>
        <option value="lab">Lab</option>
        <option value="restaurant">Restaurant</option>
      </select>
      <select id="filter-status" class="px-4 h-[40px] bg-[#ffffff] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333] rounded-[6px] text-[14px] text-[#171717] dark:text-[#ffffff] focus:outline-none focus:border-[#0070f3] transition-colors appearance-none min-w-[160px] cursor-pointer">
        <option value="all">All Statuses</option>
        <option value="Pending">Pending</option>
        <option value="Auto-Approved">Auto-Approved</option>
        <option value="Approved">Approved</option>
        <option value="Needs Clarification">Needs Clarification</option>
        <option value="Denied">Denied</option>
        <option value="Executed">Executed</option>
        <option value="Failed">Failed</option>
      </select>
      <select id="filter-risk" class="px-4 h-[40px] bg-[#ffffff] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333] rounded-[6px] text-[14px] text-[#171717] dark:text-[#ffffff] focus:outline-none focus:border-[#0070f3] transition-colors appearance-none min-w-[140px] cursor-pointer">
        <option value="all">All Risks</option>
        <option value="Normal">Normal</option>
        <option value="High">High</option>
      </select>
    </div>

    <!-- STATES -->
    <div id="loading-state" class="py-[96px] flex flex-col items-center justify-center text-[#888888]">
      <svg class="animate-spin w-8 h-8 mb-4 text-[#007cf0]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      <p class="text-[14px] font-medium leading-[20px]">Loading real requests...</p>
    </div>

    <div id="error-state" class="hidden py-[96px] flex-col items-center justify-center text-center">
      <div class="w-12 h-12 bg-[#f7d4d6] dark:bg-[#c50000]/20 rounded-full flex items-center justify-center mb-6">
        <svg class="w-6 h-6 text-[#ee0000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      </div>
      <h3 class="text-[20px] font-semibold text-[#171717] dark:text-[#ffffff] mb-2 leading-[28px] tracking-[-0.6px]">Unable to load requests.</h3>
      <p class="text-[14px] text-[#4d4d4d] dark:text-[#888888] max-w-sm mb-6 leading-[20px]">We encountered a problem while retrieving the data from the server.</p>
      <button id="retry-btn" class="h-[32px] px-[12px] bg-[#171717] dark:bg-[#ffffff] text-[#ffffff] dark:text-[#171717] rounded-[6px] text-[14px] font-medium hover:opacity-90 transition-opacity">Try Again</button>
    </div>

    <div id="empty-state" class="hidden bg-[#fafafa] dark:bg-[#111] rounded-[12px] p-[48px] text-center border border-[#ebebeb] dark:border-[#333]">
      <h3 class="text-[20px] font-semibold text-[#171717] dark:text-[#ffffff] mb-2 leading-[28px] tracking-[-0.6px]">No requests yet</h3>
      <p class="text-[14px] text-[#4d4d4d] dark:text-[#888888] max-w-sm mx-auto leading-[20px] mb-6">Create your first request to see it appear here.</p>
      <a href="/" class="h-[40px] inline-flex items-center justify-center bg-[#171717] dark:bg-[#ffffff] text-[#ffffff] dark:text-[#171717] rounded-full px-[12px] font-medium text-[14px] hover:opacity-90 transition-opacity">
        + New Request
      </a>
    </div>

    <div id="no-results-state" class="hidden py-[64px] text-center border border-[#ebebeb] dark:border-[#333] rounded-[8px] bg-[#ffffff] dark:bg-[#111]">
      <h3 class="text-[16px] font-medium text-[#171717] dark:text-[#ffffff] mb-1 leading-[24px]">No matching requests</h3>
      <p class="text-[14px] text-[#888888] leading-[20px]">Try adjusting your filters or search term.</p>
    </div>

    <!-- DATA TABLE -->
    <div id="table-container" class="hidden bg-[#ffffff] dark:bg-[#111] border border-[#ebebeb] dark:border-[#333] rounded-[8px] shadow-[0_0_0_1px_rgba(0,0,0,0.08),0_1px_1px_rgba(0,0,0,0.05),0_2px_2px_rgba(0,0,0,0.05)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.14)] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead class="bg-[#fafafa] dark:bg-[#171717] border-b border-[#ebebeb] dark:border-[#333]">
            <tr>
              <th class="px-[16px] py-[12px] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono text-[12px] leading-[16px] uppercase whitespace-nowrap font-normal">Request ID</th>
              <th class="px-[16px] py-[12px] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono text-[12px] leading-[16px] uppercase whitespace-nowrap font-normal">Domain</th>
              <th class="px-[16px] py-[12px] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono text-[12px] leading-[16px] uppercase whitespace-nowrap font-normal min-w-[240px]">Event Details</th>
              <th class="px-[16px] py-[12px] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono text-[12px] leading-[16px] uppercase whitespace-nowrap font-normal">Risk Level</th>
              <th class="px-[16px] py-[12px] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono text-[12px] leading-[16px] uppercase whitespace-nowrap font-normal">Date</th>
              <th class="px-[16px] py-[12px] text-[#4d4d4d] dark:text-[#a1a1a1] font-mono text-[12px] leading-[16px] uppercase whitespace-nowrap font-normal text-right">Status</th>
            </tr>
          </thead>
          <tbody id="table-body" class="divide-y divide-[#ebebeb] dark:divide-[#333]">
            <!-- Rows injected here by JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const emptyState = document.getElementById('empty-state');
    const noResultsState = document.getElementById('no-results-state');
    const tableContainer = document.getElementById('table-container');
    const tableBody = document.getElementById('table-body');
    const metricsContainer = document.getElementById('metrics-container');
    const filtersContainer = document.getElementById('filters-container');
    
    const filterSearch = document.getElementById('filter-search');
    const filterDomain = document.getElementById('filter-domain');
    const filterStatus = document.getElementById('filter-status');
    const filterRisk = document.getElementById('filter-risk');

    let allRequests = [];

    function show(el) { if (el) el.classList.remove('hidden'); }
    function hide(el) { if (el) el.classList.add('hidden'); }
    function showFlex(el) { if(el) { el.classList.remove('hidden'); el.classList.add('flex'); } }
    function hideFlex(el) { if(el) { el.classList.remove('flex'); el.classList.add('hidden'); } }

    async function fetchRequests() {
      hideFlex(errorState);
      hide(emptyState);
      hide(tableContainer);
      hideFlex(metricsContainer);
      hideFlex(filtersContainer);
      hide(noResultsState);
      showFlex(loadingState);

      try {
        const res = await fetch('http://localhost:8000/requests');
        if (!res.ok) throw new Error('API returned an error');
        const data = await res.json();
        
        allRequests = Array.isArray(data) ? data : [];
        
        hideFlex(loadingState);
        
        if (allRequests.length === 0) {
          show(emptyState);
        } else {
          showFlex(metricsContainer);
          showFlex(filtersContainer);
          show(tableContainer);
          updateMetrics();
          renderTable();
        }
      } catch (err) {
        console.error("Fetch error:", err);
        hideFlex(loadingState);
        showFlex(errorState);
      }
    }

    function updateMetrics() {
      const total = allRequests.length;
      const pending = allRequests.filter(r => r.status === 'Pending').length;
      const auto = allRequests.filter(r => r.status === 'Auto-Approved').length;
      const attention = allRequests.filter(r => ['Needs Clarification', 'Denied', 'Failed'].includes(r.status)).length;

      document.getElementById('metric-total').textContent = total;
      document.getElementById('metric-pending').textContent = pending;
      document.getElementById('metric-auto').textContent = auto;
      document.getElementById('metric-attention').textContent = attention;
    }

    function renderTable() {
      const searchTerm = filterSearch.value.toLowerCase();
      const domainVal = filterDomain.value;
      const statusVal = filterStatus.value;
      const riskVal = filterRisk.value;

      const filtered = allRequests.filter(r => {
        const searchStr = [
          r.request_id,
          r.domain,
          r.event_type,
          r.status,
          r.risk_level,
          JSON.stringify(r.details || {})
        ].join(' ').toLowerCase();
        
        if (searchTerm && !searchStr.includes(searchTerm)) return false;
        if (domainVal !== 'all' && r.domain?.toLowerCase() !== domainVal.toLowerCase()) return false;
        if (statusVal !== 'all' && r.status !== statusVal) return false;
        if (riskVal !== 'all' && r.risk_level !== riskVal) return false;
        return true;
      });

      if (filtered.length === 0) {
        hide(tableContainer);
        show(noResultsState);
        return;
      } else {
        show(tableContainer);
        hide(noResultsState);
      }

      tableBody.innerHTML = '';
      filtered.forEach(req => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-colors';

        // 1. ID
        const tdId = document.createElement('td');
        tdId.className = 'px-[16px] py-[16px] font-mono text-[12px] leading-[16px] text-[#4d4d4d] dark:text-[#a1a1a1] whitespace-nowrap';
        tdId.title = req.request_id || 'unknown';
        const shortId = (req.request_id || 'unknown').split('-')[0] + '...';
        tdId.textContent = shortId;

        // 2. Domain (Icon + text)
        const tdDom = document.createElement('td');
        tdDom.className = 'px-[16px] py-[16px] whitespace-nowrap text-[14px] font-medium leading-[20px] tracking-[-0.28px] capitalize text-[#171717] dark:text-[#ffffff]';
        tdDom.textContent = req.domain || 'unknown';

        // 3. Event Details
        const tdEvt = document.createElement('td');
        tdEvt.className = 'px-[16px] py-[16px]';
        let detailHtml = `<div class="font-medium text-[14px] leading-[20px] tracking-[-0.28px] text-[#171717] dark:text-[#ffffff] capitalize">${req.event_type || 'Unknown Event'}</div>`;
        
        let subText = '';
        if (req.details && req.details.items && Array.isArray(req.details.items)) {
          subText = req.details.items.map(i => `${i.quantity}x ${i.name}`).join(', ');
        }
        if (req.details && req.details.table_number) {
          subText += (subText ? ' | ' : '') + `Table ${req.details.table_number}`;
        }
        if (!subText) subText = 'No items';

        detailHtml += `<div class="text-[14px] text-[#4d4d4d] dark:text-[#a1a1a1] leading-[20px] tracking-[-0.28px] mt-1">${subText}</div>`;
        tdEvt.innerHTML = detailHtml;

        // 4. Risk Level
        const tdRisk = document.createElement('td');
        tdRisk.className = 'px-[16px] py-[16px] whitespace-nowrap';
        let riskColor = 'bg-[#f5f5f5] text-[#4d4d4d] dark:bg-[#333] dark:text-[#a1a1a1]';
        const r = (req.risk_level || '').toLowerCase();
        if (r === 'high') riskColor = 'bg-[#f7d4d6] text-[#c50000] dark:bg-[#c50000]/20 dark:text-[#ff4d4d]';
        else if (r === 'normal') riskColor = 'bg-[#d3e5ff] text-[#0761d1] dark:bg-[#0070f3]/20 dark:text-[#3291ff]';
        else if (r === 'low') riskColor = 'bg-[#aaffec] text-[#29bc9b] dark:bg-[#29bc9b]/20 dark:text-[#50e3c2]';
        
        tdRisk.innerHTML = `<span class="text-[12px] leading-[16px] px-[8px] py-[2px] rounded-full font-medium ${riskColor}">${req.risk_level || 'Unknown'}</span>`;

        // 5. Date
        const tdDate = document.createElement('td');
        tdDate.className = 'px-[16px] py-[16px] text-[#4d4d4d] dark:text-[#a1a1a1] whitespace-nowrap text-[14px] leading-[20px] tracking-[-0.28px]';
        try {
          if (!req.created_at) throw new Error();
          tdDate.textContent = new Date(req.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
        } catch(e) {
          tdDate.textContent = 'Unknown date';
        }

        // 6. Status
        const tdStatus = document.createElement('td');
        tdStatus.className = 'px-[16px] py-[16px] text-right whitespace-nowrap';
        
        let stClass = 'bg-[#f5f5f5] text-[#4d4d4d] dark:bg-[#333] dark:text-[#a1a1a1]';
        const s = req.status || '';
        if (s === 'Pending') stClass = 'bg-[#ffefcf] text-[#ab570a] dark:bg-[#f5a623]/20 dark:text-[#f9cb28]';
        else if (s === 'Auto-Approved' || s === 'Approved' || s === 'Executed') stClass = 'bg-[#d3e5ff] text-[#0761d1] dark:bg-[#0070f3]/20 dark:text-[#3291ff]';
        else if (s === 'Needs Clarification') stClass = 'bg-[#ffefcf] text-[#ab570a] dark:bg-[#f5a623]/20 dark:text-[#f9cb28]';
        else if (s === 'Denied' || s === 'Failed') stClass = 'bg-[#f7d4d6] text-[#c50000] dark:bg-[#ee0000]/20 dark:text-[#ff4d4d]';

        tdStatus.innerHTML = `<span class="inline-flex items-center text-[12px] leading-[16px] px-[8px] py-[2px] rounded-full font-medium ${stClass}">${s || 'Unknown'}</span>`;

        tr.appendChild(tdId);
        tr.appendChild(tdDom);
        tr.appendChild(tdEvt);
        tr.appendChild(tdRisk);
        tr.appendChild(tdDate);
        tr.appendChild(tdStatus);

        tableBody.appendChild(tr);
      });
    }

    // Event Listeners
    if (document.getElementById('retry-btn')) {
      document.getElementById('retry-btn').addEventListener('click', fetchRequests);
    }
    [filterSearch, filterDomain, filterStatus, filterRisk].forEach(el => {
      if(el) el.addEventListener('input', renderTable);
    });

    // Initial fetch
    fetchRequests();
  </script>
</Layout>
