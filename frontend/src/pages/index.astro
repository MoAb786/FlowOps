---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FlowOps - Request Engine">
  <div class="max-w-2xl mx-auto">
    <div class="bg-canvas border border-hairline rounded-lg p-8 shadow-[0_1px_1px_rgba(0,0,0,0.05),0_2px_2px_rgba(0,0,0,0.1)]">
      <h1 class="text-3xl font-semibold tracking-tight text-ink mb-2">Submit a Request.</h1>
      <p class="text-body text-base mb-8">Tell us what you need in plain English. We'll handle the routing and approvals.</p>
      
      <form id="requestForm" class="flex flex-col gap-4">
        <div>
          <label for="domain" class="block text-sm font-medium text-ink mb-1 font-mono uppercase tracking-widest text-[10px]">Domain</label>
          <select id="domain" name="domain" class="w-full h-10 px-3 bg-canvas border border-hairline rounded-sm text-sm focus:outline-none focus:border-ink">
            <option value="lab">Lab Equipment</option>
            <option value="restaurant">Restaurant Order</option>
          </select>
        </div>
        
        <div>
          <label for="request" class="block text-sm font-medium text-ink mb-1 font-mono uppercase tracking-widest text-[10px]">What do you need?</label>
          <textarea 
            id="request" 
            name="request" 
            rows="4" 
            placeholder="e.g. I need 2 Arduinos for my lab tomorrow" 
            class="w-full p-3 bg-canvas border border-hairline rounded-sm text-sm focus:outline-none focus:border-ink resize-none"
          ></textarea>
        </div>
        
        <button 
          type="submit" 
          class="mt-4 h-12 bg-primary text-on-primary rounded-full px-6 font-medium text-base hover:bg-black transition-colors self-start"
        >
          Submit Request
        </button>
      </form>
      
      <div id="statusMessage" class="mt-6 hidden text-sm font-medium"></div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('requestForm');
  const statusMessage = document.getElementById('statusMessage');

  if (form && statusMessage) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = (document.getElementById('domain') as HTMLSelectElement).value;
      const requestText = (document.getElementById('request') as HTMLTextAreaElement).value;
      
      statusMessage.className = "mt-6 text-sm font-medium text-mute";
      statusMessage.textContent = "Submitting...";
      
      try {
        const response = await fetch('http://localhost:8000/requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: requestText, domain: domain, sender_id: 'user_123' })
        });
        
        if (response.ok) {
          const result = await response.json();
          statusMessage.className = "mt-6 text-sm font-medium text-link";
          statusMessage.textContent = `Success! Request routed to ${result.record?.status || 'Unknown'} state.`;
          (form as HTMLFormElement).reset();
        } else {
          throw new Error("Server error");
        }
      } catch (err) {
        statusMessage.className = "mt-6 text-sm font-medium text-error";
        statusMessage.textContent = "Error submitting request. Is the backend running?";
      }
    });
  }
</script>
