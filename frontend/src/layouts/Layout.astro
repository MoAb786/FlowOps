---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="max-w-[1400px] mx-auto px-4 md:px-6">
      <nav class="h-16 flex items-center justify-between border-b border-hairline bg-canvas px-4 rounded-b-md shadow-[0_1px_1px_rgba(0,0,0,0.05)]">
        <div class="font-bold text-ink">FlowOps</div>
        <div class="flex gap-2">
          <a href="#" class="text-body text-sm font-medium px-3 py-1 hover:bg-canvas-soft rounded-full">Dashboard</a>
        </div>
      </nav>
      <main class="py-16">
        <slot />
      </main>
      <footer class="py-16 mt-16 border-t border-hairline text-center text-body text-sm">
        <p>&copy; 2026 FlowOps</p>
      </footer>
    </div>
  </body>
</html>
