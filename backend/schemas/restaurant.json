{
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["new order", "cancel order"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "integer" }
        },
        "required": ["name", "quantity"]
      }
    },
    "table_number": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Table number. Use null if not specified by the user — do NOT use 0."
    },
    "needs_human_clarification": {
      "type": "boolean"
    }
  },
  "required": ["event_type", "items", "table_number", "needs_human_clarification"]
}
