# Groq API Key (primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (fallback LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Integration
NOTION_API_KEY=your_notion_api_key_here
NOTION_REQUESTS_DB_ID=your_notion_requests_db_id_here
NOTION_RUN_LOG_DB_ID=your_notion_run_log_db_id_here

# Telegram Bot Notifications
# Create a bot via @BotFather, then message your bot and visit getUpdates to find your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
